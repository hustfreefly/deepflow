{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepflow.local/schemas/final_result_v3.schema.json",
  "title": "Solution Pro Final Result V3 Input Schema",
  "description": "Flexible input schema for Ship Pro V3. Covers 4 format variants from Solution Pro output using oneOf discrimination.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "description": "Pipeline execution status",
      "enum": ["completed", "partial", "failed", "in_progress", "unknown"]
    },
    "session_id": {
      "type": "string",
      "description": "Solution Pro session identifier"
    },
    "stage": {
      "type": "string",
      "description": "Final pipeline stage reached"
    },
    "role": {
      "type": "string",
      "description": "Agent role (e.g. orchestrator)"
    }
  },
  "oneOf": [
    {
      "$comment": "Format A: final_solution nested type (3 samples)",
      "properties": {
        "final_solution": {
          "type": "object",
          "properties": {
            "executive_summary": {
              "type": "object",
              "properties": {
                "problem": { "type": "string" },
                "solution": { "type": "string" },
                "core_value": { "type": "string" }
              }
            },
            "detailed_solution": {
              "type": "object",
              "properties": {
                "architecture": { "type": "object" },
                "implementation": { "type": "object" },
                "risk_management": { "type": "object" }
              }
            },
            "quality_assurance": {
              "type": "object",
              "properties": {
                "review_results": { "type": "array" },
                "harness_final_gate": { "type": "object" }
              }
            },
            "recommendations": {
              "type": "object",
              "properties": {
                "immediate": { "type": "array", "items": { "type": "string" } },
                "short_term": { "type": "array", "items": { "type": "string" } },
                "long_term": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "required": ["executive_summary"]
        },
        "layer2_response": {
          "type": "object",
          "properties": {
            "constraints": { "type": "array" }
          }
        },
        "covered_req_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirement_evidence": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      },
      "required": ["status", "final_solution"]
    },
    {
      "$comment": "Format B: flat domain type (2 samples)",
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "generated_at": { "type": "string", "format": "date-time" }
          },
          "required": ["name"]
        },
        "requirements": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "coverage_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "items": { "type": "array" }
          }
        },
        "architecture": {
          "type": "object",
          "properties": {
            "style": { "type": "string" },
            "layers": { "type": "array" },
            "components": { "type": "array" }
          },
          "required": ["style"]
        },
        "model_routing": { "type": "object" },
        "rag_architecture": { "type": "object" },
        "implementation_plan": {
          "type": "object",
          "properties": {
            "duration": { "type": "string" },
            "phases": { "type": "array" }
          }
        },
        "cost_analysis": { "type": "object" },
        "risk_management": { "type": "object" },
        "quality_assurance": { "type": "object" },
        "recommendations": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object" }
          ]
        }
      },
      "required": ["project", "architecture"]
    },
    {
      "$comment": "Format C: pipeline_summary type (1 sample)",
      "properties": {
        "pipeline_summary": {
          "type": "object",
          "properties": {
            "total_stages": { "type": "integer" },
            "stages_completed": { "type": "integer" },
            "harness_final_score": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["total_stages", "stages_completed"]
        },
        "executive_summary": {
          "type": "object",
          "properties": {
            "project_name": { "type": "string" },
            "core_problem": { "type": "string" },
            "solution_overview": { "type": "string" }
          },
          "required": ["project_name", "core_problem", "solution_overview"]
        },
        "req_coverage": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "covered": { "type": "integer" },
            "details": { "type": "array" }
          }
        },
        "quality_scores": { "type": "object" },
        "architecture": {
          "type": "object",
          "properties": {
            "style": { "type": "string" },
            "api_gateway": { "type": "string" },
            "microservices_framework": { "type": "object" }
          }
        },
        "deployment": { "type": "object" },
        "known_gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["pipeline_summary", "executive_summary"]
    },
    {
      "$comment": "Format D: minimal type (2 samples, status or summary only)",
      "properties": {
        "summary": { "type": "string" },
        "message": { "type": "string" },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["status"] },
        { "required": ["summary"] }
      ],
      "not": { "required": ["final_solution"] },
      "not": { "required": ["project"] },
      "not": { "required": ["pipeline_summary"] }
    }
  ]
}
