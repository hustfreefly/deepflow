{
  "$defs": {
    "AcceptanceTest": {
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "expected_exit_code": {
          "default": 0,
          "title": "Expected Exit Code",
          "type": "integer"
        },
        "expected_output_contains": {
          "default": "",
          "title": "Expected Output Contains",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "AcceptanceTest",
      "type": "object"
    },
    "Architecture": {
      "properties": {
        "style": {
          "default": "",
          "title": "Style",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ArchitectureComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "layers": {
          "items": {
            "type": "string"
          },
          "title": "Layers",
          "type": "array"
        }
      },
      "title": "Architecture",
      "type": "object"
    },
    "ArchitectureComponent": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "",
          "title": "Type",
          "type": "string"
        },
        "technology": {
          "default": "",
          "title": "Technology",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ArchitectureComponent",
      "type": "object"
    },
    "Budget": {
      "properties": {
        "tokens": {
          "minimum": 1000,
          "title": "Tokens",
          "type": "integer"
        },
        "time_minutes": {
          "minimum": 1,
          "title": "Time Minutes",
          "type": "integer"
        },
        "max_retries": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "required": [
        "tokens",
        "time_minutes"
      ],
      "title": "Budget",
      "type": "object"
    },
    "ComplexityDistribution": {
      "properties": {
        "trivial": {
          "default": 0,
          "title": "Trivial",
          "type": "integer"
        },
        "low": {
          "default": 0,
          "title": "Low",
          "type": "integer"
        },
        "medium": {
          "default": 0,
          "title": "Medium",
          "type": "integer"
        },
        "high": {
          "default": 0,
          "title": "High",
          "type": "integer"
        },
        "critical": {
          "default": 0,
          "title": "Critical",
          "type": "integer"
        }
      },
      "title": "ComplexityDistribution",
      "type": "object"
    },
    "DependencyEdge": {
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "type": {
          "default": "hard",
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "DependencyEdge",
      "type": "object"
    },
    "DependencyGraph": {
      "properties": {
        "execution_order": {
          "items": {
            "type": "string"
          },
          "title": "Execution Order",
          "type": "array"
        },
        "parallel_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Parallel Groups",
          "type": "array"
        },
        "critical_path": {
          "items": {
            "type": "string"
          },
          "title": "Critical Path",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "execution_order",
        "parallel_groups"
      ],
      "title": "DependencyGraph",
      "type": "object"
    },
    "Generator": {
      "properties": {
        "agent": {
          "const": "ship-pro",
          "default": "ship-pro",
          "title": "Agent",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "model",
        "version"
      ],
      "title": "Generator",
      "type": "object"
    },
    "Layer1Structural": {
      "properties": {
        "score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "checks_passed": {
          "default": 0,
          "title": "Checks Passed",
          "type": "integer"
        },
        "checks_total": {
          "default": 0,
          "title": "Checks Total",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/QualityIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "Layer1Structural",
      "type": "object"
    },
    "Layer2Semantic": {
      "properties": {
        "score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "coverage_assessment": {
          "default": "",
          "title": "Coverage Assessment",
          "type": "string"
        },
        "coherence_assessment": {
          "default": "",
          "title": "Coherence Assessment",
          "type": "string"
        },
        "feasibility_assessment": {
          "default": "",
          "title": "Feasibility Assessment",
          "type": "string"
        }
      },
      "title": "Layer2Semantic",
      "type": "object"
    },
    "Layer3Actionable": {
      "properties": {
        "score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "clarity_score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity Score",
          "type": "number"
        },
        "testability_score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Testability Score",
          "type": "number"
        },
        "dependency_completeness": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Dependency Completeness",
          "type": "number"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        }
      },
      "title": "Layer3Actionable",
      "type": "object"
    },
    "OutputArtifact": {
      "properties": {
        "type": {
          "enum": [
            "file",
            "directory",
            "api_endpoint",
            "database_migration",
            "config",
            "test",
            "documentation"
          ],
          "title": "Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "title": "OutputArtifact",
      "type": "object"
    },
    "PackageMeta": {
      "properties": {
        "package_id": {
          "description": "Unique package identifier (e.g. SP-001)",
          "pattern": "^SP-[0-9]+$",
          "title": "Package Id",
          "type": "string"
        },
        "project_name": {
          "default": "",
          "title": "Project Name",
          "type": "string"
        },
        "generated_at": {
          "description": "ISO 8601 generation timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "$ref": "#/$defs/Generator"
        },
        "source_session_id": {
          "title": "Source Session Id",
          "type": "string"
        },
        "input_format": {
          "default": "A_final_solution",
          "enum": [
            "A_final_solution",
            "B_flat_domain",
            "C_pipeline_summary",
            "D_minimal"
          ],
          "title": "Input Format",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "package_id",
        "generated_at",
        "generator",
        "source_session_id"
      ],
      "title": "PackageMeta",
      "type": "object"
    },
    "PackageSummary": {
      "properties": {
        "total_wps": {
          "title": "Total Wps",
          "type": "integer"
        },
        "estimated_effort": {
          "title": "Estimated Effort",
          "type": "string"
        },
        "total_token_budget": {
          "default": 0,
          "title": "Total Token Budget",
          "type": "integer"
        },
        "total_time_minutes": {
          "default": 0,
          "title": "Total Time Minutes",
          "type": "integer"
        },
        "parallel_time_minutes": {
          "default": 0,
          "title": "Parallel Time Minutes",
          "type": "integer"
        },
        "complexity_distribution": {
          "$ref": "#/$defs/ComplexityDistribution"
        },
        "narrative": {
          "default": "",
          "title": "Narrative",
          "type": "string"
        },
        "immediate_next_steps": {
          "items": {
            "type": "string"
          },
          "title": "Immediate Next Steps",
          "type": "array"
        }
      },
      "required": [
        "total_wps",
        "estimated_effort"
      ],
      "title": "PackageSummary",
      "type": "object"
    },
    "ProjectContext": {
      "properties": {
        "problem_statement": {
          "title": "Problem Statement",
          "type": "string"
        },
        "solution_overview": {
          "title": "Solution Overview",
          "type": "string"
        },
        "core_value": {
          "default": "",
          "title": "Core Value",
          "type": "string"
        },
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "requirements_coverage": {
          "$ref": "#/$defs/RequirementsCoverage"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "known_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Known Gaps",
          "type": "array"
        }
      },
      "required": [
        "problem_statement",
        "solution_overview"
      ],
      "title": "ProjectContext",
      "type": "object"
    },
    "QualityIssue": {
      "properties": {
        "check": {
          "default": "",
          "title": "Check",
          "type": "string"
        },
        "status": {
          "default": "pass",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityReport": {
      "properties": {
        "layer1_structural": {
          "$ref": "#/$defs/Layer1Structural"
        },
        "layer2_semantic": {
          "$ref": "#/$defs/Layer2Semantic"
        },
        "layer3_actionable": {
          "$ref": "#/$defs/Layer3Actionable"
        },
        "overall_score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Overall Score",
          "type": "number"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "QualityReport",
      "type": "object"
    },
    "RequirementCoverageItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "status": {
          "default": "covered",
          "enum": [
            "covered",
            "partial",
            "gap"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RequirementCoverageItem",
      "type": "object"
    },
    "RequirementsCoverage": {
      "properties": {
        "total": {
          "default": 0,
          "title": "Total",
          "type": "integer"
        },
        "covered": {
          "default": 0,
          "title": "Covered",
          "type": "integer"
        },
        "coverage_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Rate",
          "type": "number"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RequirementCoverageItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "RequirementsCoverage",
      "type": "object"
    },
    "RetryPolicy": {
      "properties": {
        "on_failure": {
          "default": "abort",
          "enum": [
            "abort",
            "retry",
            "skip",
            "fallback"
          ],
          "title": "On Failure",
          "type": "string"
        },
        "fallback_wp": {
          "default": "",
          "title": "Fallback Wp",
          "type": "string"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "RiskRegisterItem": {
      "properties": {
        "id": {
          "pattern": "^RISK-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "certain",
            "likely",
            "possible",
            "unlikely",
            "rare"
          ],
          "title": "Likelihood",
          "type": "string"
        },
        "mitigation": {
          "default": "",
          "title": "Mitigation",
          "type": "string"
        },
        "affected_wps": {
          "items": {
            "type": "string"
          },
          "title": "Affected Wps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "likelihood"
      ],
      "title": "RiskRegisterItem",
      "type": "object"
    },
    "WorkPackage": {
      "properties": {
        "id": {
          "pattern": "^WP-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "complexity": {
          "enum": [
            "trivial",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Complexity",
          "type": "string"
        },
        "model_tier": {
          "default": "auto",
          "enum": [
            "claude-opus",
            "claude-sonnet",
            "claude-haiku",
            "gpt-4o",
            "gpt-4o-mini",
            "qwen-max",
            "qwen-plus",
            "auto"
          ],
          "title": "Model Tier",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "context_files": {
          "items": {
            "type": "string"
          },
          "title": "Context Files",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/OutputArtifact"
          },
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "acceptance_tests": {
          "items": {
            "$ref": "#/$defs/AcceptanceTest"
          },
          "title": "Acceptance Tests",
          "type": "array"
        },
        "retry_policy": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "requires_human_approval": {
          "default": false,
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "budget",
        "complexity",
        "priority",
        "outputs",
        "acceptance_criteria"
      ],
      "title": "WorkPackage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ship Pro V3 最终交付物契约。\n\nPydantic 模型是唯一真相源。JSON Schema 由 ShipPackage.model_json_schema() 生成。\n所有 Prompt 中的输出格式和 Gate 中的字段检查都应从此模型派生。",
  "properties": {
    "schema_version": {
      "const": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/PackageMeta"
    },
    "project_context": {
      "$ref": "#/$defs/ProjectContext"
    },
    "work_packages": {
      "items": {
        "$ref": "#/$defs/WorkPackage"
      },
      "minItems": 1,
      "title": "Work Packages",
      "type": "array"
    },
    "dependency_graph": {
      "$ref": "#/$defs/DependencyGraph"
    },
    "risk_register": {
      "items": {
        "$ref": "#/$defs/RiskRegisterItem"
      },
      "title": "Risk Register",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/PackageSummary"
    },
    "quality_report": {
      "$ref": "#/$defs/QualityReport"
    }
  },
  "required": [
    "schema_version",
    "meta",
    "project_context",
    "work_packages",
    "dependency_graph",
    "summary"
  ],
  "title": "ShipPackage",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepflow.local/schemas/ship_package_v3.schema.json"
}