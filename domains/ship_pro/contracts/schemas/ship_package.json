{
  "$defs": {
    "DependencyGraph": {
      "description": "工作包依赖图",
      "properties": {
        "edges": {
          "description": "依赖边列表，如 [{from: 'WP-001', to: 'WP-002'}]",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Edges",
          "type": "array"
        },
        "execution_order": {
          "description": "执行顺序（拓扑排序后的层级）",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Execution Order",
          "type": "array"
        },
        "parallel_groups": {
          "description": "可并行执行的工作包组",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Parallel Groups",
          "type": "array"
        }
      },
      "title": "DependencyGraph",
      "type": "object"
    },
    "WorkPackage": {
      "description": "工作包定义",
      "properties": {
        "id": {
          "description": "工作包 ID（如 WP-001）",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "工作包标题",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "工作包描述",
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "description": "验收标准列表",
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "dependencies": {
          "description": "依赖的其他工作包 ID 列表",
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "estimated_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "预估工作量（自由格式）",
          "title": "Estimated Effort"
        },
        "deliverables": {
          "description": "交付物列表",
          "items": {
            "type": "string"
          },
          "title": "Deliverables",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "WorkPackage",
      "type": "object"
    }
  },
  "description": "Ship Pro 最终交付物包",
  "properties": {
    "solution_name": {
      "description": "解决方案名称",
      "title": "Solution Name",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "description": "版本",
      "title": "Version",
      "type": "string"
    },
    "work_packages": {
      "description": "所有工作包列表",
      "items": {
        "$ref": "#/$defs/WorkPackage"
      },
      "title": "Work Packages",
      "type": "array"
    },
    "dependency_graph": {
      "$ref": "#/$defs/DependencyGraph"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "元数据（不包含主交付物内容）",
      "title": "Metadata",
      "type": "object"
    },
    "optional_suggestions": {
      "description": "可选建议（不影响主交付物）",
      "items": {
        "type": "string"
      },
      "title": "Optional Suggestions",
      "type": "array"
    },
    "web_search_logs": {
      "description": "所有 Worker 的 web_search 日志",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Web Search Logs",
      "type": "array"
    }
  },
  "required": [
    "solution_name"
  ],
  "title": "ShipPackage",
  "type": "object"
}