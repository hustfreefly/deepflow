{
  "$defs": {
    "DependencyGraph": {
      "description": "工作包依赖图",
      "properties": {
        "edges": {
          "description": "依赖边列表，如 [{from: 'WP-001', to: 'WP-002'}]",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Edges",
          "type": "array"
        },
        "execution_order": {
          "description": "执行顺序（拓扑排序后的层级）",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Execution Order",
          "type": "array"
        },
        "parallel_groups": {
          "description": "可并行执行的工作包组",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Parallel Groups",
          "type": "array"
        }
      },
      "title": "DependencyGraph",
      "type": "object"
    },
    "WorkPackage": {
      "description": "工作包定义",
      "properties": {
        "id": {
          "description": "工作包 ID（如 WP-001）",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "工作包标题",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "工作包描述",
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "description": "验收标准列表",
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "dependencies": {
          "description": "依赖的其他工作包 ID 列表",
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "estimated_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "预估工作量（自由格式）",
          "title": "Estimated Effort"
        },
        "deliverables": {
          "description": "交付物列表",
          "items": {
            "type": "string"
          },
          "title": "Deliverables",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "WorkPackage",
      "type": "object"
    }
  },
  "description": "Ship Pro 最终交付物包",
  "properties": {
    "solution_name": {
      "description": "解决方案名称",
      "title": "Solution Name",
      "type": "string"
    },
    "work_packages": {
      "description": "所有工作包列表",
      "items": {
        "$ref": "#/$defs/WorkPackage"
      },
      "title": "Work Packages",
      "type": "array"
    },
    "dependency_graph": {
      "$ref": "#/$defs/DependencyGraph"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "元数据（不包含主交付物内容）",
      "title": "Metadata",
      "type": "object"
    },
    "semantic_anchors": {
      "description": "从上游 Solution Pro 透传的语义锚点列表，用于信息守恒验证",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "constraint": {
            "type": "string"
          },
          "applicable_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "type": "array",
      "title": "Semantic Anchors"
    },
    "anchor_coverage": {
      "description": "语义锚点覆盖率统计",
      "type": "object",
      "properties": {
        "total_anchors": {
          "type": "integer"
        },
        "covered_anchors": {
          "type": "integer"
        },
        "coverage_rate": {
          "type": "number"
        },
        "uncovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "Anchor Coverage"
    }
  },
  "required": [
    "solution_name"
  ],
  "title": "ShipPackage",
  "type": "object"
}