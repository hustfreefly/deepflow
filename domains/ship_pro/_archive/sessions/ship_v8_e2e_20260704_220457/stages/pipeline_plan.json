      "relevant_decisions": [
        "D8: guardrails-ai单框架 — 统一使用guardrails-ai框架执行所有护栏检查",
        "D9: Hash Chain审计日志 — 所有安全事件记录到不可篡改的审计链"
      ],
      "relevant_risks": [
        "R8: Prompt Injection — 多层检测+Zone 0硬编码，RTO<100ms",
        "R11: LLM API速率限制 — RPM监控+指数退避",
        "R15: 用户中断处理 — TERMINATE信号+状态保存"
