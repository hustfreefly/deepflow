        "Loop_Engine"
      ],
      "interface_provides": [
        "validate_schema(artifact, schema) → validation_result",
        "judge_with_llm(artifact, criteria) → judgment_score",
        "merge_decisions(schema_result, llm_result) → final_verdict",
        "detect_deviation(current_state, goal_tree) → deviation_score",
        "evaluate_quality(artifact, quality_dims) → quality_report"
      ],
      "interface_requires": [
        "Loop_Engine.start_loop() → loop_context",
        "State_Manager.read_state() → current_artifact"
      ],
      "relevant_decisions": [
        "D3: 原生Structured Output替代xgrammar — 使用模型原生结构化输出进行Schema校验",
        "D6: 单一Thompson Sampling — 质量评估中多臂选择采用Thompson Sampling",
        "D10: 同模型族Judge+严格隔离 — LLM Judge使用同模型族但严格隔离评估上下文"
      ],
      "relevant_risks": [
        "R1: Quality Gate高reject率 — UTD策略+max 3轮+断路器，RTO 4.5min",
        "R2: Token超预算 — 软限+硬限+降级策略"
      ],
      "estimated_wps": 5,
      "estimated_effort_hours": 100
    },
    {
      "role": "Self_Evolution",
      "module_purpose": "自我优化与持续进化模块：Dream Loop在空闲时自动反思历史执行(GRADE框架)并将Insight写入memory；Meta Loop通过Thompson Sampling+LLM-as-Optimizer自动调参(timeout/重试/模型选择)，所有参数调整限定在安全边界内",
      "covered_req_ids": [
        "REQ-011",
        "REQ-012",
        "REQ-025",
        "REQ-045",
        "REQ-069"
      ],
      "depends_on": [
        "Loop_Engine",
        "State_Manager"
      ],
      "interface_provides": [
        "run_dream_reflection(execution_history) → list[insight]",
        "write_insight_to_memory(insight) → void",
        "optimize_params(performance_data) → param_update",
        "validate_param_bounds(proposed_change) → safe_bool",
        "get_exploration_ratio() → ratio_float"
      ],
      "interface_requires": [
        "Loop_Engine.terminate_loop() → execution_history",
        "State_Manager.write_atomic() → persist_insight",
        "Safety_Shield.validate_param_bounds() → bounds_check"
      ],
      "relevant_decisions": [
        "D5: LLM-as-Optimizer替代Optuna — 使用LLM本身作为参数优化器，无需外部优化框架",
        "D7: 增强现有memory系统 — Dream Loop的Insight写入现有memory系统，不新建存储"
      ],
      "relevant_risks": [
        "R4: Dream Loop有害heuristic — Human Review Gate+pending→验证→生效三阶段"
      ],
      "estimated_wps": 4,
      "estimated_effort_hours": 80
    }
  ],
  "execution_order": [
    [
      "State_Manager"
    ],
    [
      "DAG_Scheduler",
      "Safety_Shield"
    ],
    [
      "Loop_Engine"
    ],
    [
      "Quality_Gate",
      "Self_Evolution"
    ]
  ],
  "rationale": "按Solution Pro架构的分形三层Loop+确定性骨架+LLM语义决策混合模式拆分为5个模块。State_Manager作为Blackboard持久化基础层，所有上层模块依赖其原子写入和状态恢复能力。DAG_Scheduler和Safety_Shield构成中间可并行层：前者负责任务分解与调度，后者负责安全护栏与故障恢复，两者均仅依赖State_Manager可独立开发测试。Loop_Engine是核心编排层，依赖前三者实现三层嵌套Loop+心跳+通知。Quality_Gate和Self_Evolution是上层验证与优化模块，依赖Loop_Engine提供的执行上下文，可并行开发。每个REQ-ID严格分配给一个Worker，共覆盖全部73个covered_req_ids和7个pending_req_ids。"
}