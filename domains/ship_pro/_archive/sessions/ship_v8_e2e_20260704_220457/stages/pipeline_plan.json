{
  "workers": [
    {
      "role": "State_Manager",
      "module_purpose": "Blackboard状态持久化层：管理JSON Blackboard存储、原子写入(rename)、per-stage锁、SHA-256校验、跨Session状态恢复与checkpoint，以及Zone边界强制执行的底层基础设施",
      "covered_req_ids": [
        "REQ-024",
        "REQ-029",
        "REQ-054",
        "REQ-055",
        "REQ-056",
        "REQ-057",
        "REQ-058",
        "REQ-059",
        "REQ-060",
        "REQ-061",
        "REQ-062",
        "REQ-063",
        "REQ-075"
      ],
      "depends_on": [],
      "interface_provides": [
        "blackboard_init(goal_id) → state_handle",
        "read_state(handle, stage) → json_object",
        "write_atomic(handle, stage, data) → sha256_hash",
        "acquire_lock(handle, stage) → lock_token",
        "release_lock(handle, stage, token) → void",
        "recover_checkpoint(goal_id) → state_snapshot",
        "enforce_zone_boundary(zone_id, operation) → allowed_bool"
      ],
      "interface_requires": [],
      "relevant_decisions": [
        "D2: JSON统一序列化 — 所有状态数据采用JSON格式，确保可读性和跨语言兼容",
        "D9: Hash Chain审计日志 — 每次状态变更记录SHA-256哈希链，保证不可篡改"
      ],
      "relevant_risks": [
        "R6: 状态文件损坏 — 通过原子写入+SHA-256校验+安全暂停缓解",
        "R7: 并发竞态条件 — 通过per-stage lock+唯一任务ID缓解"
      ],
      "estimated_wps": 5,
      "estimated_effort_hours": 80
    },
    {
      "role": "DAG_Scheduler",
      "module_purpose": "任务分解与调度引擎：将目标分解为DAG任务图，基于优先级队列+拓扑排序进行调度，管理Worker分配(最大6并发)，动态调整分配策略，追踪失败并触发上报",
      "covered_req_ids": [
        "REQ-006",
        "REQ-010",
        "REQ-013",
        "REQ-030",
        "REQ-033",
        "REQ-036",
        "REQ-052",
        "REQ-065",
        "REQ-066",
        "REQ-067",
        "REQ-068",
        "REQ-070",
        "REQ-072"
      ],
      "depends_on": [
        "State_Manager"
      ],
      "interface_provides": [
        "decompose_goal(goal) → task_dag",
        "get_ready_tasks(dag) → list[task]",
        "assign_worker(task, worker_profile) → assignment",
        "set_max_concurrency(n) → void",
        "track_failure(task_id, error) → failure_count",
        "adjust_allocation(history) → new_allocation"
      ],
      "interface_requires": [
        "State_Manager.read_state() → task_progress",
        "State_Manager.write_atomic() → persist_assignment"
      ],
      "relevant_decisions": [
        "D4: 简单优先级队列+拓扑排序 — DAG调度采用优先级队列结合拓扑排序，兼顾依赖关系和执行效率"
      ],
      "relevant_risks": [
        "R5: DAG死锁 — 通过死锁检测+重新规划缓解"
      ],
      "estimated_wps": 6,
      "estimated_effort_hours": 100
    },
    {
      "role": "Safety_Shield",
      "module_purpose": "安全与可靠性保障层：实现三级死循环熔断器、Zone 0/1/2分层护栏强制执行、Prompt Injection多层检测、四阶段故障恢复决策树(含跨厂商fallback)、资源硬限与API速率管控",
      "covered_req_ids": [
        "REQ-016",
        "REQ-017",
        "REQ-018",
        "REQ-032",
        "REQ-034",
        "REQ-047",
        "REQ-049",
        "REQ-064",
