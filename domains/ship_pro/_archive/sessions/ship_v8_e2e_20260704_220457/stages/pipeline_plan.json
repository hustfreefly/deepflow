    {
      "role": "Quality_Gate",
      "module_purpose": "质量验证与方向纠偏模块：三层验证(Pydantic Schema校验→LLM Judge评估→合并决策)、方向偏离检测(Embedding+Goal Tree+IDS混合)、关键节点门控、多引擎迭代+多轮Review质量保证",
      "covered_req_ids": [
        "REQ-002",
        "REQ-004",
        "REQ-007",
        "REQ-019",
        "REQ-020",
        "REQ-021",
        "REQ-038",
