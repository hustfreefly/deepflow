{
  "$defs": {
    "WorkerSpec": {
      "description": "单个 Worker 的规格定义",
      "properties": {
        "role": {
          "description": "Worker 角色名称（自由命名）",
          "title": "Role",
          "type": "string"
        },
        "task_description": {
          "description": "任务描述",
          "title": "Task Description",
          "type": "string"
        },
        "required_inputs": {
          "description": "需要读取的 Blackboard stage 列表",
          "items": {
            "type": "string"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "expected_output_stage": {
          "description": "输出写入的 stage 名称",
          "title": "Expected Output Stage",
          "type": "string"
        },
        "output_schema": {
          "default": "WorkerDeliverable",
          "description": "输出必须符合的 Pydantic 模型名",
          "title": "Output Schema",
          "type": "string"
        },
        "depends_on": {
          "description": "依赖的其他 Worker role 列表",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "needs_web_search": {
          "default": false,
          "description": "是否需要 web search 权限",
          "title": "Needs Web Search",
          "type": "boolean"
        },
        "web_search_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "搜索范围描述（如有权限）",
          "title": "Web Search Scope"
        },
        "must_constraints": {
          "description": "从 Solution Pro 继承的 MUST 约束描述（语义描述，非 ID）",
          "items": {
            "type": "string"
          },
          "title": "Must Constraints",
          "type": "array"
        },
        "solution_pro_refs": {
          "description": "引用的 Solution Pro 具体字段路径",
          "items": {
            "type": "string"
          },
          "title": "Solution Pro Refs",
          "type": "array"
        }
      },
      "required": [
        "role",
        "task_description",
        "expected_output_stage"
      ],
      "title": "WorkerSpec",
      "type": "object"
    }
  },
  "description": "Phase 1 Planner 的结构化输出",
  "properties": {
    "input_type": {
      "description": "输入类型（自由分类）",
      "title": "Input Type",
      "type": "string"
    },
    "complexity": {
      "description": "复杂度（自由分类）",
      "title": "Complexity",
      "type": "string"
    },
    "domain": {
      "description": "领域描述",
      "title": "Domain",
      "type": "string"
    },
    "analysis_summary": {
      "description": "1-2 句分析结论",
      "title": "Analysis Summary",
      "type": "string"
    },
    "workers": {
      "description": "Worker 规格列表",
      "items": {
        "$ref": "#/$defs/WorkerSpec"
      },
      "title": "Workers",
      "type": "array"
    },
    "integration_strategy": {
      "description": "整合策略（自由描述）",
      "title": "Integration Strategy",
      "type": "string"
    }
  },
  "required": [
    "input_type",
    "complexity",
    "domain",
    "analysis_summary",
    "workers",
    "integration_strategy"
  ],
  "title": "PlannerOutput",
  "type": "object"
}