{
  "$schema": "deepflow/pipeline_watcher_config/v2",
  "pipeline_id": "ship_pro",
  "display_name": "Ship Pro",

  "limits": {
    "max_runs": 15,
    "timeout_minutes": 30,
    "circuit_breaker_threshold": 3
  },

  "detection": {
    "completed_file": ".completed",
    "completed_timestamp_field": "completed_at",
    "scan_dirs": [
      {
        "path": ".",
        "pattern": "*_output.json",
        "stage_files": {
          "architect_output.json": {"name": "Architect", "seq": 1, "icon": "🏗️"},
          "decomposer_output.json": {"name": "Decomposer", "seq": 2, "icon": "🧩"},
          "specifier_output.json": {"name": "Specifier", "seq": 3, "icon": "📐"},
          "reviewer_output.json": {"name": "Reviewer", "seq": 4, "icon": "👁️"},
          "packager_output.json": {"name": "Packager", "seq": 5, "icon": "📦"}
        }
      }
    ],
    "total_stages": 5,
    "final_artifact": "packager_output.json"
  },

  "stage_symbols": {
    "done": "✅",
    "running": "⏳",
    "pending": "⬜"
  },

  "auto_chain": {
    "enabled": false,
    "next_pipeline": null,
    "trigger_on": "completed",
    "trigger_file": ".auto_chain_trigger"
  }
}
