        "at": "_handle_abort_degradation()"
      },
      {
        "schema": "ResearchDigest",
        "cages": [
          "confidence 0-1",
          "relevance enum"
        ],
        "at": "_generate_research_digest() non-blocking"
      },
      {
        "schema": "ModuleOrchestratorStateSchema",
        "cages": [
          "status enum",
          "retry>=0"
        ],
        "at": "_load_or_init_state()"
      },
      {
        "schema": "StageContract",
        "cages": [
