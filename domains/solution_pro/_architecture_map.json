  "checkpoint_resume": {
    "L1": "v2/master_state.json (SHA256 hash)",
    "L2": "v2/{module}_output.json (readback+hash)",
    "per_stage": {
      "planning": "meta,reviewer_meta,expert_plans/*,convergence,reviewer_convergence,harness,planning_convergence",
      "research": "freshness,config,experts/*,consolidator,digest,research_convergence",
      "review_qc": "review_qc_convergence"
    },
    "contract": "_load_checkpoint()->STAGE_CONTRACTS->validate()"
  },
  "architecture_decisions": {
    "code_controls_flow": "Python deterministic, LLM semantic only",
    "no_mock_prod": "spawn_fn=None->raise",
    "degradation=failure": "Except ReviewQC ABORT",
    "dual_state": "master+module+artifact hash",
    "harness_2layer": "system guardrails+role quality+reflection",
    "living_spec_priority": "living_spec>frozen_spec>user_input",
    "p0_traceability": "P0 REQ->Gate B->Expert->UC->Checklist->Matrix"
  }
