  "agent_contracts": {
    "meta_planner": {
      "role": "L0: task->experts->gates",
      "output": "ExpertManifestSchema",
      "rules": [
        "P0 required",
        "Experts 1-5",
        "Gate A sum=1.0",
        "P0 REQ 100% trace",
        "Domain coverage"
      ]
    },
    "expert_planner": {
      "role": "L1: constraints/risks/criteria",
      "output": "ExpertPlanSchema",
      "rules": [
        "5-15 constraints",
        "rationale",
        "C/R/AC IDs",
        "P0 only"
      ]
    },
    "convergence_planner": {
      "role": "L2: merge+validate+trace",
      "output": "UnifiedConstraints+Checklist",
      "rules": [
        "Semantic dedup",
        "P0 100%",
        "Executable",
        "merge 0.5-0.8"
      ]
    },
    "harness_agent": {
      "role": "Gate A+B",
      "output": "HarnessReportSchema",
      "dual": "L1 rule->L2 LLM-judge"
    },
    "research_expert": {
      "role": "Parallel research+iteration",
      "output": "ResearchExpertSchema",
      "rules": [
        "ExecSummary/Findings/Confidence",
        "format<50%=Error",
        "MAX_ITER=3"
      ]
    },
    "fix_loop": {
      "role": "Detect+fix max 3",
      "output": "FixLoopStateSchema",
      "rules": [
        "MAX_ROUNDS=3",
        "Finding Ledger",
        "ABORT->Degraded"
      ]
    }
  },
  "contract_cages": {
    "pydantic": [
      {
        "schema": "ExpertManifestSchema",
        "cages": [
          "GateAWeights sum=1.0"
        ],
        "at": "_run_meta_planner()"
      },
      {
        "schema": "ExpertPlanSchema",
        "cages": [
          "constraints min=1",
          "criteria min=1"
        ],
        "at": "_run_single_expert_with_retry()"
      },
      {
        "schema": "UnifiedConstraintsSchema",
        "cages": [
          "F6:LLM control scope",
          "F7:threshold consistency"
        ],
        "at": "_run_convergence_planner()"
      },
      {
        "schema": "VerificationChecklistSchema",
        "cages": [
          "checklist min=1"
        ],
        "at": "_run_convergence_planner()"
      },
      {
        "schema": "PlanningConvergenceSchema",
        "cages": [
          "summary max=500",
          "module Literal",
          "SemanticVerification enum"
        ],
        "at": "_generate_planning_convergence()"
      },
      {
        "schema": "ResearchConvergenceSchema",
        "cages": [
          "summary max=1000",
          "GateAScoresSchema",
          "GateBResultsSchema"
        ],
        "at": "_generate_research_convergence()"
      },
      {
        "schema": "HarnessCheck",
        "cages": [
          "H1:4dims",
          "H2:P0=FAIL",
          "H3:aggregation",
          "H4:no-L2",
          "H5:anti-complacency",
          "H6:anti-evasion",
          "H7:mandatory",
          "H8:beyond-spec"
        ],
        "at": "_run_harness_check()"
      },
      {
        "schema": "FixLoopStateSchema",
        "cages": [
          "round 0-2",
          "status enum"
        ],
        "at": "_run_fix_loop()"
      },
      {
        "schema": "DegradedFinalConvergenceSchema",
        "cages": [
          "degradation_flag=True",
          "status=DEGRADED"
