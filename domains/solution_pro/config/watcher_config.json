{
  "$schema": "deepflow/pipeline_watcher_config/v2",
  "pipeline_id": "solution_pro",
  "display_name": "方案设计",

  "limits": {
    "max_runs": 20,
    "timeout_minutes": 60,
    "circuit_breaker_threshold": 3
  },

  "detection": {
    "completed_file": ".completed",
    "completed_timestamp_field": "completed_at",
    "scan_dirs": [
      {
        "path": "stages",
        "pattern": "*.json",
        "stage_files": {
          "planning.json": {"name": "Planning", "seq": 2, "icon": "📝"},
          "reviewer_technical.json": {"name": "Reviewers", "seq": 3, "merge_group": "reviewers", "icon": "👁️"},
          "reviewer_business.json": {"name": "Reviewers", "seq": 3, "merge_group": "reviewers", "icon": "👁️"},
          "reviewer_risk.json": {"name": "Reviewers", "seq": 3, "merge_group": "reviewers", "icon": "👁️"},
          "research_expert_1.json": {"name": "Research", "seq": 4, "merge_group": "research", "icon": "🔬"},
          "research_expert_2.json": {"name": "Research", "seq": 4, "merge_group": "research", "icon": "🔬"},
          "research_expert_3.json": {"name": "Research", "seq": 4, "merge_group": "research", "icon": "🔬"},
          "consolidator.json": {"name": "Consolidator", "seq": 5, "icon": "🧩"},
          "audit.json": {"name": "Audit", "seq": 6, "icon": "🔍"},
          "fix.json": {"name": "Fix", "seq": 7, "icon": "🔧"},
          "fixer_expert.json": {"name": "Fixer Expert", "seq": 8, "icon": "🛠️"},
          "harness_final.json": {"name": "Harness Final", "seq": 9, "icon": "✅"},
          "final_result.json": {"name": "Summarizer", "seq": 10, "icon": "📋"}
        }
      },
      {
        "path": "data",
        "pattern": "*.json",
        "stage_files": {
          "collection.json": {"name": "Data Collection", "seq": 1, "icon": "📊"}
        }
      }
    ],
    "total_stages": 10,
    "final_artifact": "final_solution.md"
  },

  "stage_symbols": {
    "done": "✅",
    "running": "⏳",
    "pending": "⬜"
  },

  "auto_chain": {
    "enabled": false,
    "next_pipeline": null,
    "trigger_on": "completed",
    "trigger_file": ".auto_chain_trigger"
  }
}
