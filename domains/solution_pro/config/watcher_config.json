{
  "$schema": "deepflow/pipeline_watcher_config/v2",
  "pipeline_id": "solution_pro",
  "display_name": "Solution Pro",
  "limits": {
    "max_runs": 20,
    "timeout_minutes": 60,
    "circuit_breaker_threshold": 5
  },
  "detection": {
    "completed_file": ".completed",
    "completed_timestamp_field": "completed_at",
    "scan_dirs": [
      {
        "path": "stages",
        "pattern": "*.json",
        "stage_files": {
          "planning.json": {
            "name": "规划",
            "seq": 2,
            "icon": "📝"
          },
          "reviewer_technical.json": {
            "name": "评审 (×3)",
            "seq": 3,
            "icon": "👁️",
            "merge_group": "reviewers"
          },
          "reviewer_business.json": {
            "name": "评审 (×3)",
            "seq": 3,
            "icon": "👁️",
            "merge_group": "reviewers"
          },
          "reviewer_risk.json": {
            "name": "评审 (×3)",
            "seq": 3,
            "icon": "👁️",
            "merge_group": "reviewers"
          },
          "research_expert_1.json": {
            "name": "研究 (×3)",
            "seq": 4,
            "icon": "🔬",
            "merge_group": "research"
          },
          "research_expert_2.json": {
            "name": "研究 (×3)",
            "seq": 4,
            "icon": "🔬",
            "merge_group": "research"
          },
          "research_expert_3.json": {
            "name": "研究 (×3)",
            "seq": 4,
            "icon": "🔬",
            "merge_group": "research"
          },
          "consolidator.json": {
            "name": "整合",
            "seq": 5,
            "icon": "🧩"
          },
          "audit.json": {
            "name": "审计",
            "seq": 6,
            "icon": "🔍"
          },
          "fix.json": {
            "name": "修复",
            "seq": 7,
            "icon": "🔧"
          },
          "fixer_expert.json": {
            "name": "深度修复",
            "seq": 8,
            "icon": "🛠️"
          },
          "harness_final.json": {
            "name": "最终验证",
            "seq": 9,
            "icon": "✅"
          },
          "summarizer.json": {
            "name": "总结",
            "seq": 10,
            "icon": "📋"
          }
        }
      },
      {
        "path": "data",
        "pattern": "*.json",
        "stage_files": {
          "collection.json": {
            "name": "数据收集",
            "seq": 1,
            "icon": "📊"
          }
        }
      }
    ],
    "total_stages": 10,
    "final_artifact": "final_result.json"
  },
  "templates": {
    "progress": "🟠 [{project_short}] {current_phase_name}\n{progress_bar} {completed}/{total} 阶段\n⏱️ 已运行 {elapsed_time} · 预计剩余 {remaining}\n\n{detail_list}",
    "completed": "✅ [{project_short}] {display_name} 完成\n{progress_bar} {completed}/{total} 阶段\n⏱️ 总耗时 {elapsed_time}\n📄 交付物: {final_artifact}",
    "failed": "🔴 [{project_short}] {display_name} 失败\n\n已完成: {completed}/{total} 阶段\n失败原因: {error}",
    "timeout": "⚠️ [{project_short}] {display_name} 运行超时（已运行 {timeout_minutes} 分钟）\n\norchestrator 可能已崩溃。已完成的阶段结果仍在目录中。\n建议查看已有结果或重新启动。",
    "circuit_break": "⚠️ [{project_short}] Cron 巡检连续 {failures} 次无输出\n\n可能 orchestrator 已停止或管线异常。\n请检查 stages/.stage_progress.json"
  },
  "stage_symbols": {
    "done": "✅",
    "running": "⏳",
    "pending": "⬜"
  },
  "auto_chain": {
    "enabled": true,
    "next_pipeline": "ship_pro",
    "trigger_on": "completed",
    "trigger_file": ".auto_chain_trigger"
  }
}