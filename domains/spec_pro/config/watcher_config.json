        }
      }
    ],
    "total_stages": 10,
    "final_artifact": "spec/living_spec.json"
  },

  "stage_symbols": {
    "done": "✅",
    "running": "⏳",
    "pending": "⬜"
  },

  "auto_chain": {
    "enabled": false,
    "next_pipeline": null,
    "trigger_on": "completed",
    "trigger_file": ".auto_chain_trigger"
  }
}
