{
  "$schema": "deepflow/pipeline_watcher_config/v2",
  "pipeline_id": "spec_pro",
  "display_name": "Spec Pro",

  "limits": {
    "max_runs": 20,
    "timeout_minutes": 60,
    "circuit_breaker_threshold": 3
  },

  "detection": {
    "completed_file": ".completed",
    "completed_timestamp_field": "completed_at",
    "scan_dirs": [
      {
        "path": "stages",
        "pattern": "*.json",
        "stage_files": {
          "round_01_parse.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01"},
          "round_01_response.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01"},
          "round_01_questions.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01"},
          "round_02_parse.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02"},
          "round_02_response.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02"},
          "round_02_questions.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02"},
          "round_03_parse.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03"},
          "round_03_response.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03"},
          "round_03_questions.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03"},
          "round_04_parse.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04"},
          "round_04_response.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04"},
          "round_04_questions.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04"},
          "round_05_parse.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05"},
          "round_05_response.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05"},
          "round_05_questions.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05"},
          "round_06_parse.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06"},
          "round_06_response.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06"},
          "round_06_questions.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06"},
          "round_07_parse.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07"},
          "round_07_response.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07"},
          "round_07_questions.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07"},
          "round_08_parse.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08"},
          "round_08_response.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08"},
          "round_08_questions.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08"},
          "round_09_parse.json": {"name": "Round 9", "seq": 9, "merge_group": "round_09"},
          "round_09_response.json": {"name": "Round 9", "seq": 9, "merge_group": "round_09"},
          "round_09_questions.json": {"name": "Round 9", "seq": 9, "merge_group": "round_09"},
          "round_10_parse.json": {"name": "Round 10", "seq": 10, "merge_group": "round_10"},
          "round_10_response.json": {"name": "Round 10", "seq": 10, "merge_group": "round_10"},
          "round_10_questions.json": {"name": "Round 10", "seq": 10, "merge_group": "round_10"}
        }
      }
    ],
    "total_stages": 10,
    "final_artifact": "spec/living_spec.json"
  },

  "templates": {
    "progress": "📊 {display_name}进度 ({completed}/{total})\n━━━━━━━━━━━━━━━━━━━━\n{stage_lines}\n\n已耗时: {elapsed_time}",
    "completed": "✅ {display_name}完成！\n\n📊 {completed}/{total} 阶段完成 | 耗时 {elapsed_time}\n📄 输出: {final_artifact}",
    "failed": "⚠️ {display_name}失败\n\n已完成: {completed}/{total} 阶段\n失败原因: {error}",
    "timeout": "⚠️ {display_name}运行超时（已运行 {timeout_minutes} 分钟）\n\norchestrator 可能已崩溃。已完成的阶段结果仍在目录中。\n建议查看已有结果或重新启动。",
    "circuit_break": "⚠️ Cron 巡检连续 {failures} 次无输出\n\n可能 orchestrator 已停止或管线异常。\n请检查 {base_path}/.stage_progress.json"
  },

  "stage_symbols": {
    "done": "✅",
    "running": "⏳",
    "pending": "⬜"
  },

  "auto_chain": {
    "enabled": false,
    "next_pipeline": null,
    "trigger_on": "completed",
    "trigger_file": ".auto_chain_trigger"
  }
}
