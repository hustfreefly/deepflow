{
  "$schema": "deepflow/pipeline_watcher_config/v2",
  "pipeline_id": "spec_pro",
  "display_name": "Spec Pro",

  "limits": {
    "max_runs": 20,
    "timeout_minutes": 60,
    "circuit_breaker_threshold": 3
  },

  "detection": {
    "completed_file": ".completed",
    "completed_timestamp_field": "completed_at",
    "scan_dirs": [
      {
        "path": "stages",
        "pattern": "*.json",
        "stage_files": {
          "round_01_parse.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01", "icon": "🔁"},
          "round_01_response.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01", "icon": "🔁"},
          "round_01_questions.json": {"name": "Round 1", "seq": 1, "merge_group": "round_01", "icon": "🔁"},
          "round_02_parse.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02", "icon": "🔁"},
          "round_02_response.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02", "icon": "🔁"},
          "round_02_questions.json": {"name": "Round 2", "seq": 2, "merge_group": "round_02", "icon": "🔁"},
          "round_03_parse.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03", "icon": "🔁"},
          "round_03_response.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03", "icon": "🔁"},
          "round_03_questions.json": {"name": "Round 3", "seq": 3, "merge_group": "round_03", "icon": "🔁"},
          "round_04_parse.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04", "icon": "🔁"},
          "round_04_response.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04", "icon": "🔁"},
          "round_04_questions.json": {"name": "Round 4", "seq": 4, "merge_group": "round_04", "icon": "🔁"},
          "round_05_parse.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05", "icon": "🔁"},
          "round_05_response.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05", "icon": "🔁"},
          "round_05_questions.json": {"name": "Round 5", "seq": 5, "merge_group": "round_05", "icon": "🔁"},
          "round_06_parse.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06", "icon": "🔁"},
          "round_06_response.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06", "icon": "🔁"},
          "round_06_questions.json": {"name": "Round 6", "seq": 6, "merge_group": "round_06", "icon": "🔁"},
          "round_07_parse.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07", "icon": "🔁"},
          "round_07_response.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07", "icon": "🔁"},
          "round_07_questions.json": {"name": "Round 7", "seq": 7, "merge_group": "round_07", "icon": "🔁"},
          "round_08_parse.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08", "icon": "🔁"},
          "round_08_response.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08", "icon": "🔁"},
          "round_08_questions.json": {"name": "Round 8", "seq": 8, "merge_group": "round_08", "icon": "🔁"},
          "round_09_parse.json": {"name": "Round 9", "seq": 9, "merge_group": "round_09", "icon": "🔁"},
          "round_09_response.json": {"name": "Round 9", "seq": 9, "merge_group": "round_09", "icon": "🔁"},
