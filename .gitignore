# DeepFlow .gitignore

# 运行时生成的测试结果
blackboard/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 系统文件
.DS_Store
Thumbs.db

# CodeGraph 运行时文件
.codegraph/daemon.pid
.codegraph/daemon.sock
.codegraph/daemon.log

# 测试结果（运行时产物）
tests/results/*.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# 虚拟环境
venv/
env/
ENV/

# 日志
*.log
logs/

# 临时文件（发布前清理）
*.backup
*.bak
*.tmp
*~

# cage 临时契约文件（保留正式契约）
cage/*_contract.yaml
cage/*_fix_*.md
cage/*_test_*.py
cage/*_preplay_*.md
cage/*_plan*.md
cage/*_summary*.md
!cage/*_contract.yaml
!cage/*_phase*.yaml
!cage/*_test_contract.yaml
!cage/*_requirements*.md
!cage/DEVELOPMENT_CONTRACT.md
!cage/prompt-output-fix.md

# 前端依赖和构建产物
frontend/web/node_modules/
frontend/web/dist/
frontend/web/.vite/
frontend/backend/__pycache__/
frontend/backend/.venv/
frontend/backend/venv/

# 其他临时文件
analysis_context.json
tasks.json
prompts_full_analysis.*
prompts_inventory.*

# 归档的旧代码
ARCHIVED/

# 临时文件
*.tmp
*.bak
*.db
*.sqlite
*.sqlite3

# 运行时数据
.vector_memory_db/
.metrics/
.inspection/
data/cache.db
sector_analysis.db

# 测试缓存
.pytest_cache/
.coverage
htmlcov/

# 敏感信息
.env
*.env
secrets.yaml
credentials.yaml
test_results/
config.json

# 生成的报告
reports/

# 上传文件目录
frontend/backend/routers/uploads/

# 任务队列测试数据
frontend/task_queue/*.json

# frontend/frontend 嵌套目录
frontend/frontend/

# 敏感凭证
.credentials/

# CodeGraph 完整目录
.codegraph/

