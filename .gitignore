# DeepFlow .gitignore

# 运行时生成的测试结果
blackboard/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# 虚拟环境
venv/
env/
ENV/

# 日志
*.log
logs/

# 临时文件（发布前清理）
*.backup
*.bak
*.tmp
*~

# 临时测试文件
test_*.py
*_test.py

# 临时验证报告
*_test_report.md
*_test_result.json
*_report.json
*_audit.json

# cage 临时契约文件（保留正式契约）
cage/*_contract.yaml
cage/*_fix_*.md
cage/*_test_*.py
cage/*_preplay_*.md
cage/*_plan*.md
cage/*_summary*.md
!cage/update_docs_contract.yaml
!cage/release_cleanup_contract.yaml
!cage/english_refactor_contract.yaml

# 其他临时文件
analysis_context.json
tasks.json
prompts_full_analysis.*
prompts_inventory.*

# 临时文件
*.tmp
*.bak
*.db
*.sqlite
*.sqlite3

# 运行时数据
.vector_memory_db/
.metrics/
.inspection/
data/cache.db
sector_analysis.db

# 测试缓存
.pytest_cache/
.coverage
htmlcov/

# 敏感信息
.env
*.env
secrets.yaml
credentials.yaml
test_results/
